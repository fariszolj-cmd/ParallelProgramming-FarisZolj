# Linux laptop, MPI and OpenMP (GCC + OpenMPI)

ERT_RESULTS Results.moj_laptop

ERT_DRIVER  driver1
ERT_KERNEL  kernel1

ERT_MPI  True
ERT_MPI_CFLAGS  -I/usr/lib/x86_64-linux-gnu/openmpi/include -I/usr/lib/x86_64-linux-gnu/openmpi/include/openmpi
ERT_MPI_LDFLAGS -L/usr/lib/x86_64-linux-gnu/openmpi/lib -lmpi

ERT_OPENMP         True
ERT_OPENMP_CFLAGS  -fopenmp
ERT_OPENMP_LDFLAGS -fopenmp

ERT_FLOPS   1,4,16
ERT_ALIGN   64

ERT_CC      mpicxx
ERT_CFLAGS  -O3 -march=native -fstrict-aliasing -ftree-vectorize

ERT_LD      mpicxx
ERT_LDFLAGS 
ERT_LDLIBS

ERT_PRECISION FP64

ERT_RUN     export OMP_NUM_THREADS=ERT_OPENMP_THREADS; mpirun -np ERT_MPI_PROCS ERT_CODE

ERT_PROCS_THREADS  8
ERT_MPI_PROCS      1
ERT_OPENMP_THREADS 4,8
ERT_NUM_EXPERIMENTS 1
ERT_MEMORY_MAX 268435456
ERT_WORKING_SET_MIN 1
ERT_TRIALS_MIN 1
ERT_GNUPLOT gnuplot
