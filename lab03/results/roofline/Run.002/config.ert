# Maeve i7-6800K 2 x 6 'Broadway' processors

ERT_RESULTS Results.assignment-2


ERT_DRIVER  driver1
ERT_KERNEL  kernel1

ERT_MPI         False
ERT_MPI_CFLAGS
ERT_MPI_LDFLAGS

ERT_OPENMP         True
ERT_OPENMP_CFLAGS  -fopenmp
ERT_OPENMP_LDFLAGS -fopenmp

ERT_FLOPS   1,2,4,8,16
ERT_ALIGN   32

ERT_CC      g++
ERT_CFLAGS  -O3 -funroll-loops -ftree-vectorize -fopenmp

ERT_LD      g++
ERT_LDFLAGS -O3 -fopenmp  

ERT_PRECISION FP64

ERT_RUN  export OMP_NUM_THREADS=ERT_OPENMP_THREADS; export OMP_PLACES=threads; export OMP_PROC_BIND=spread; ./ERT_CODE

ERT_PROCS_THREADS  12
ERT_OPENMP_THREADS 1-12

ERT_NUM_EXPERIMENTS 5

ERT_MEMORY_MAX 1073741824

ERT_WORKING_SET_MIN 1

ERT_TRIALS_MIN 1

ERT_GNUPLOT gnuplot
ERT_LDLIBS
ERT_PROCS_THREADS  4
ERT_OPENMP_THREADS 1,2,4
ERT_MEMORY_MAX 268435456
